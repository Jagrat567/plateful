NODE_ENV=development
PORT=5000
# Comma-separated frontend origins are supported (production, preview, local).
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/plateful
ORDER_SIMULATION_ENABLED=true
ORDER_STATUS_INTERVAL_MS=60000
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_NAME=Plateful Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeMe123
RESEND_API_KEY=
EMAIL_FROM=Plateful <orders@example.com>
APP_URL=http://localhost:5173
DEMO_OWNER_PASSWORD=DemoOwner123
